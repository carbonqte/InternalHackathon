# Copy to .env for local runs. On Render, set these in the service's Environment tab instead.
# Never commit the real .env: it's in .gitignore.

# Supabase (Project Settings -> API). Leave empty to serve the website's JSON files instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may use the admin pages (comma-separated emails that sign in with Supabase Auth)
ADMIN_EMAILS=

# Which sites may call this API (comma-separated). Default: the Vercel site + localhost.
CORS_ORIGINS=

# ElevenLabs read-aloud (elevenlabs.io -> Profile -> API keys; voice id from the Voices page)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# LLM for the extraction pipeline and smart search (console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Only pages on these domains can be imported
SOURCE_DOMAINS=gov.in,nic.in
